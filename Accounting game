        function startMission(diff) {
            if (!selectedDate) {
                showFeedback("Please select a date first!", "danger");
                return;
            }
            
            currentDifficulty = diff;
            currentDay = selectedDate;
            currentDiff = diff;
            currentVersion = Math.floor(Math.random() * 3) + 1;
            
            const cacheKey = `${selectedDate}_${diff}`;
            if (!versionCache[cacheKey]) {
                versionCache[cacheKey] = {
                    1: generateDailyTransactions(selectedDate, diff, 1),
                    2: generateDailyTransactions(selectedDate, diff, 2),
                    3: generateDailyTransactions(selectedDate, diff, 3)
                };
            }
            
            transactions = versionCache[cacheKey][currentVersion];
            
            if (!transactions || transactions.length === 0) {
                showFeedback("Error generating transactions. Please try again.", "danger");
                return;
