            `;
            container.appendChild(rewardDiv);
            
            transactions.forEach((t, index) => {
                const recorded = journal.find(j => j.id === t.id);
                const isCorrect = recorded && recorded.debit === t.correctDebit && recorded.credit === t.correctCredit && recorded.amount === t.amount;
                const html = `
                    <div class="transaction" style="border-left-color: ${isCorrect ? 'var(--success)' : 'var(--danger)'};">
