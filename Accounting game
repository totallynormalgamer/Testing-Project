        function generateDailyTransactions(day, difficulty, version) {
            const diffCode = difficulty === 'easy' ? 7 : difficulty === 'medium' ? 13 : difficulty === 'hard' ? 23 : 31;
            const seed = day * 7919 + version * 6271 + diffCode * 5437;
            
            function seededRandom(seedVal) {
                const x = Math.sin(seedVal) * 10000;
                return x - Math.floor(x);
            }
            
            function rand(min, max, offset = 0) {
                const val = seededRandom(seed + min * 37 + max * 53 + offset * 71);
                return Math.floor(val * (max - min + 1)) + min;
            }
            
            function shuffleArray(arr, offset) {
                const result = [...arr];
                for (let i = result.length - 1; i > 0; i--) {
                    const j = rand(0, i, offset + i * 89);
                    [result[i], result[j]] = [result[j], result[i]];
                }
                return result;
            }
            
            let pool;
            if (difficulty === 'easy') pool = EASY_POOL;
            else if (difficulty === 'medium') pool = MEDIUM_POOL;
            else if (difficulty === 'hard') pool = HARD_POOL;
            else pool = ULTRA_POOL;
            
            if (pool.length === 0) return [];
            
            const numTransactions = difficulty === 'easy' ? 3 : difficulty === 'medium' ? 4 : difficulty === 'hard' ? 5 : 6;
            
            const trackerKey = `${difficulty}_${version}`;
            if (!usedScenarioTracker[trackerKey]) {
                usedScenarioTracker[trackerKey] = new Set();
            }
            const usedSet = usedScenarioTracker[trackerKey];
            
            const uniqueScenarios = [];
            const seenPairs = new Set();
            for (const scenario of pool) {
                const pair = `${scenario.debit}|${scenario.credit}`;
                if (!seenPairs.has(pair)) {
                    seenPairs.add(pair);
                    uniqueScenarios.push(scenario);
                }
            }
            
            const shuffledPool = shuffleArray(uniqueScenarios, version * 97 + day * 83);
            
            const availableScenarios = shuffledPool.filter(s => {
                const key = `${s.debit}|${s.credit}`;
                return !usedSet.has(key);
            });
            
            let selectedScenarios;
            if (availableScenarios.length < numTransactions) {
                usedScenarioTracker[trackerKey] = new Set();
                const resetAvailable = shuffledPool.filter(s => {
                    const key = `${s.debit}|${s.credit}`;
                    return !usedSet.has(key);
                });
                selectedScenarios = resetAvailable.slice(0, numTransactions);
                selectedScenarios.forEach(s => {
                    usedScenarioTracker[trackerKey].add(`${s.debit}|${s.credit}`);
                });
            } else {
                selectedScenarios = availableScenarios.slice(0, numTransactions);
                selectedScenarios.forEach(s => {
                    usedScenarioTracker[trackerKey].add(`${s.debit}|${s.credit}`);
                });
            }
            
            const selected = [];
            selectedScenarios.forEach((scenario, i) => {
                const descAmount = extractAmountFromDesc(scenario.desc);
                const amount = descAmount !== null ? descAmount : 1000 + (i * 137 + 73) % 99000;
                
                selected.push({
                    id: day * 100000 + (difficulty === 'easy' ? 1 : difficulty === 'medium' ? 2 : difficulty === 'hard' ? 3 : 4) * 10000 + version * 1000 + i + 1,
                    desc: scenario.desc,
                    correctDebit: scenario.debit,
                    correctCredit: scenario.credit,
                    amount: amount,
                    explanation: scenario.explanation
                });
            });
            
            return selected;
        }

        function getRelevantAccounts(transactions) {
            const accounts = new Set();
            transactions.forEach(t => {
                accounts.add(t.correctDebit);
                accounts.add(t.correctCredit);
            });
            const extras = ["Cash", "Accounts Receivable", "Accounts Payable", "Supplies", "Equipment", "Inventory", 
                "Prepaid Insurance", "Service Revenue", "Expense", "Notes Payable", "Unearned Revenue", 
                "Owner's Capital", "Dividends", "Bad Debt Recovery", "Interest Revenue", "Rent Revenue",
                "Accumulated Depreciation", "Depreciation Expense", "Bad Debt Expense", "Interest Expense",
                "Accrued Salaries", "Allowance for Doubtful Accounts", "Treasury Stock", "Bank Overdraft"];
            extras.forEach(a => accounts.add(a));
            return Array.from(accounts);
        }

