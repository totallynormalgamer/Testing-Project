        function getExpToNextLevel(lvl) {
            return Math.floor(100 + (lvl - 1) * 25 + (lvl - 1) * (lvl - 1) * 2);
        }

        function addExp(amount) {
            let multiplier = 1;
            if (userInventory.xp_boost && userInventory.xp_boost > 0) {
                multiplier = 2;
                userInventory.xp_boost--;
                showFeedback('🚀 EXP Booster activated! Double EXP!', 'success');
            }
            
            const finalAmount = Math.floor(amount * multiplier);
            exp += finalAmount;
            let leveledUp = false;
            let levelUpCount = 0;
            
            while (exp >= expToNextLevel) {
                exp -= expToNextLevel;
                level++;
                expToNextLevel = getExpToNextLevel(level);
                leveledUp = true;
                levelUpCount++;
            }
            
            updateDisplay();
            saveGameProgress();
            
            if (leveledUp) {
                const bonus = levelUpCount * 25;
                coins += bonus;
                updateDisplay();
                saveGameProgress();
                showLevelUpModal(levelUpCount, bonus);
            }
            
            return leveledUp;
        }

