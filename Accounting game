        function extractAmountFromDesc(desc) {
            const match = desc.match(/\$(\d+)/);
            return match ? parseInt(match[1]) : null;
        }

        function generateDailyTransactions(day, difficulty, version) {
            const diffCode = difficulty === 'easy' ? 7 : difficulty === 'medium' ? 13 : difficulty === 'hard' ? 23 : 31;
            const seed = day * 7919 + version * 6271 + diffCode * 5437;
            
            function seededRandom(seedVal) {
                const x = Math.sin(seedVal) * 10000;
                return x - Math.floor(x);
            }
            
            function rand(min, max, offset = 0) {
                const val = seededRandom(seed + min * 37 + max * 53 + offset * 71);
                return Math.floor(val * (max - min + 1)) + min;
            }
            
            function shuffleArray(arr, offset) {
                const result = [...arr];
                for (let i = result.length - 1; i > 0; i--) {
                    const j = rand(0, i, offset + i * 89);
                    [result[i], result[j]] = [result[j], result[i]];
                }
                return result;
            }
            
            const amounts = {
                easy: [75, 120, 200, 300, 450, 500, 150, 250, 180, 350],
                medium: [600, 850, 1200, 1500, 2200, 2800, 3500, 4200, 4800, 5500],
                hard: [700, 1200, 1800, 2500, 3200, 4000, 4800, 5600, 6500, 7800],
                ultra: [1500, 2500, 4000, 5500, 7000, 9000, 11000, 13000, 16000, 20000]
            };
            
            let pool;
            if (difficulty === 'easy') pool = EASY_POOL;
            else if (difficulty === 'medium') pool = MEDIUM_POOL;
            else if (difficulty === 'hard') pool = HARD_POOL;
            else pool = ULTRA_POOL;
            
            if (pool.length === 0) return [];
            
            const numTransactions = difficulty === 'easy' ? 3 : difficulty === 'medium' ? 4 : difficulty === 'hard' ? 5 : 6;
            const availableAmounts = amounts[difficulty] || amounts.easy;
            
            const shuffledPool = shuffleArray(pool, version * 97 + day * 83);
            const shuffledAmounts = shuffleArray(availableAmounts, version * 73 + day * 61);
            
            const startIdx = (version * 53 + day * 47) % shuffledPool.length;
            
            const selected = [];
            const usedIndices = new Set();
            
            for (let i = 0; i < numTransactions; i++) {
                let scenarioIdx;
                let attempts = 0;
                do {
                    scenarioIdx = (startIdx + i * (version % 5 + 1) + day * 3 + attempts * 7) % shuffledPool.length;
                    attempts++;
                } while (usedIndices.has(scenarioIdx) && attempts < shuffledPool.length);
                usedIndices.add(scenarioIdx);
                
                const scenario = shuffledPool[scenarioIdx];
                const amountIdx = (i * (version % 7 + 1) + day * 5 + version * 2) % shuffledAmounts.length;
                let amount = shuffledAmounts[amountIdx];
                
                const descAmount = extractAmountFromDesc(scenario.desc);
                if (descAmount !== null) amount = descAmount;
                
                selected.push({
                    id: day * 100000 + (difficulty === 'easy' ? 1 : difficulty === 'medium' ? 2 : difficulty === 'hard' ? 3 : 4) * 10000 + version * 1000 + i + 1,
                    desc: scenario.desc,
                    correctDebit: scenario.debit,
                    correctCredit: scenario.credit,
                    amount: amount,
                    explanation: scenario.explanation
                });
            }
            return selected;
        }

        function getRelevantAccounts(transactions) {
            const accounts = new Set();
            transactions.forEach(t => {
                accounts.add(t.correctDebit);
                accounts.add(t.correctCredit);
            });
            const extras = ["Cash", "Accounts Receivable", "Accounts Payable", "Supplies", "Equipment", "Inventory", "Prepaid Insurance", "Service Revenue", "Salary Expense", "Rent Expense", "Utilities Expense", "Interest Expense", "Depreciation Expense"];
            extras.forEach(a => accounts.add(a));
            return Array.from(accounts);
        }

