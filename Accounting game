        function renderTAccounts() {
            const container = document.getElementById('t-accounts');
            container.innerHTML = '';
            
            const history = transactionHistory || [];
            if (history.length === 0) {
                container.innerHTML = `<div style="grid-column:1/-1;text-align:center;color:var(--text-secondary);padding:40px;">Complete a mission first to see T-Accounts!</div>`;
                return;
            }

            const balances = {};
            const accountTransactions = {};
            
            history.forEach(mission => {
                mission.transactions.forEach(entry => {
                    if (!accountTransactions[entry.debit]) accountTransactions[entry.debit] = [];
                    if (!accountTransactions[entry.credit]) accountTransactions[entry.credit] = [];
                    
                    accountTransactions[entry.debit].push({
                        type: 'debit',
                        amount: entry.amount,
                        desc: entry.desc,
                        date: mission.date
                    });
                    accountTransactions[entry.credit].push({
                        type: 'credit',
                        amount: entry.amount,
                        desc: entry.desc,
                        date: mission.date
                    });
                    
                    if (!balances[entry.debit]) balances[entry.debit] = 0;
                    if (!balances[entry.credit]) balances[entry.credit] = 0;
                    balances[entry.debit] += entry.amount;
                    balances[entry.credit] -= entry.amount;
                });
            });

            const allAccounts = new Set();
            history.forEach(mission => {
                mission.transactions.forEach(entry => {
                    allAccounts.add(entry.debit);
                    allAccounts.add(entry.credit);
                });
            });

            allAccounts.forEach(acc => {
                if (!balances[acc]) balances[acc] = 0;
                if (!accountTransactions[acc]) accountTransactions[acc] = [];
            });

            const sortedAccounts = Object.keys(balances).sort((a, b) => {
                const balA = balances[a];
                const balB = balances[b];
                if (balA > 0 && balB <= 0) return -1;
                if (balA <= 0 && balB > 0) return 1;
                return 0;
            });

            let accountIndex = 0;
            sortedAccounts.forEach(acc => {
                const bal = balances[acc];
                const isBalanced = bal === 0;
                const div = document.createElement('div');
                div.className = `t-account ${isBalanced ? 'balanced' : 'unbalanced'}`;
                div.id = 'account-' + accountIndex;
                div.onclick = () => toggleAccount(accountIndex);
                
                const hasDebitBalance = bal > 0;
                const hasCreditBalance = bal < 0;
                const absBal = Math.abs(bal);
                
                const txs = accountTransactions[acc] || [];
                const debitTxs = txs.filter(t => t.type === 'debit');
                const creditTxs = txs.filter(t => t.type === 'credit');
                
                div.innerHTML = `
                    <h3 style="display:flex;justify-content:space-between;align-items:center;cursor:pointer;">
                        <span>${acc}</span>
                        <span class="balance-badge ${isBalanced ? 'balanced' : 'unbalanced'}">
                            ${isBalanced ? '⚖️ Balanced' : hasDebitBalance ? '🔴 Debit Balance' : '🔵 Credit Balance'}
                        </span>
                    </h3>
                    <div style="display:flex;justify-content:space-between;margin-top:8px;">
                        <span>Debit: <strong style="color:#4ade80;">$${bal > 0 ? bal.toFixed(2) : '0.00'}</strong></span>
                        <span>Credit: <strong style="color:#f87171;">$${bal < 0 ? Math.abs(bal).toFixed(2) : '0.00'}</strong></span>
                    </div>
                    <div class="account-detail">
                        <div style="font-size:13px; color:var(--text-secondary); margin-bottom:6px;">📋 Transaction History:</div>
                        ${debitTxs.map(t => `<div class="detail-row"><span style="color:#4ade80;">Dr</span> <span>${t.desc.substring(0, 30)}${t.desc.length > 30 ? '...' : ''}</span> <span style="color:#4ade80;">+$${t.amount}</span></div>`).join('')}
                        ${creditTxs.map(t => `<div class="detail-row"><span style="color:#f87171;">Cr</span> <span>${t.desc.substring(0, 30)}${t.desc.length > 30 ? '...' : ''}</span> <span style="color:#f87171;">-$${t.amount}</span></div>`).join('')}
                        ${debitTxs.length === 0 && creditTxs.length === 0 ? '<div class="detail-row" style="color:#64748b;">No transactions</div>' : ''}
                        <div class="detail-row" style="font-weight:bold; border-top:2px solid #475569; margin-top:4px; padding-top:6px;">
                            <span>Net Balance</span>
                            <span style="color:${isBalanced ? '#4ade80' : hasDebitBalance ? '#4ade80' : '#f87171'};">$${absBal.toFixed(2)} ${isBalanced ? '⚖️' : hasDebitBalance ? 'Dr' : 'Cr'}</span>
                        </div>
                    </div>
                    <div style="margin-top:8px; font-size:12px; color:#64748b; text-align:center;">
                        👆 Click to expand/collapse
                    </div>
                `;
                container.appendChild(div);
                accountIndex++;
            });
        }

