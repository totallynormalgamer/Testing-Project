                return;
            }
            const item = SHOP_ITEMS.find(i => i.id === itemId);
            if (!item) return;
            
            if (userInventory[itemId] || item.price === 0) {
                setTheme(themeName);
                return;
            }
            
            if (coins < item.price) {
                showFeedback(`Not enough coins! Need ${item.price} 🪙`, 'danger');
                return;
            }
            
            coins -= item.price;
            userInventory[itemId] = 1;
            saveGameProgress();
            renderShop();
            updateDisplay();
            setTheme(themeName);
            showFeedback(`✅ Purchased ${item.name} theme!`, 'success');
        }

        function buyItem(itemId) {
            if (!currentUser) {
                showAuthAlert('Please login to shop!');
                return;
            }
            const item = SHOP_ITEMS.find(i => i.id === itemId);
            if (!item) return;
            
            if (coins < item.price) {
                showFeedback(`Not enough coins! Need ${item.price} 🪙`, 'danger');
                return;
            }
            
            coins -= item.price;
            if (!userInventory[itemId]) userInventory[itemId] = 0;
            userInventory[itemId]++;
            saveGameProgress();
            renderShop();
            updateDisplay();
            showFeedback(`✅ Purchased ${item.name}!`, 'success');
        }

        // --- INVENTORY ---
        function renderInventory() {
            const container = document.getElementById('inventory-content');
            container.innerHTML = '';
            
            const inventoryItems = Object.keys(userInventory).filter(key => userInventory[key] > 0);
            
            if (inventoryItems.length === 0) {
                container.innerHTML = `
                    <div style="text-align:center; padding:40px; color:var(--text-secondary);">
                        <div style="font-size:48px; margin-bottom:16px;">📦</div>
                        <div>Your inventory is empty.</div>
                        <div style="font-size:14px; margin-top:8px;">Visit the shop to buy items!</div>
                    </div>
                `;
                return;
            }
            
            const itemMap = {};
            SHOP_ITEMS.forEach(item => {
                itemMap[item.id] = item;
            });
            Object.values(EXCLUSIVE_ITEMS).forEach(item => {
                itemMap[item.id] = item;
            });
            
            let html = `<div class="inventory-grid">`;
            
            inventoryItems.forEach(id => {
                const count = userInventory[id];
                const item = itemMap[id];
                if (!item) return;
                
                const isTheme = item.type === 'theme' || id.startsWith('theme_');
                const isExclusive = id === 'theme_gold' || id === 'theme_silver' || id === 'theme_bronze';
                const emoji = item.emoji || '📦';
                const name = item.name || id;
                const desc = item.desc || 'No description';
                
                html += `
                    <div class="inventory-item">
                        <div class="item-emoji">${emoji}</div>
                        <div class="item-name">${name}</div>
                        <div class="item-count">x${count}</div>
                        <div class="item-desc">${desc}</div>
                        ${isTheme ? `<div style="margin-top:8px;"><button onclick="setTheme('${item.theme || id.replace('theme_', '')}')" style="padding:6px 12px; font-size:12px; background:var(--primary); color:white; border:none; border-radius:6px; cursor:pointer;">Apply Theme</button></div>` : ''}
                        ${isExclusive ? `<div style="margin-top:8px; font-size:12px; color:var(--gold);">🏆 Exclusive Reward</div>` : ''}
                    </div>
                `;
            });
            
            html += `</div>`;
            container.innerHTML = html;
        }

        // --- SCREEN NAVIGATION ---
        function showScreen(screen) {
            document.querySelectorAll('#game-area > div').forEach(div => div.style.display = 'none');
            document.getElementById(screen + '-screen').style.display = 'block';
            document.querySelectorAll('.sidebar .nav-btn').forEach(btn => btn.classList.remove('active'));
            const activeBtn = Array.from(document.querySelectorAll('.sidebar .nav-btn')).find(btn => btn.getAttribute('onclick').includes(`'${screen}'`));
            if (activeBtn) activeBtn.classList.add('active');
            if (screen === 'shop') renderShop();
            if (screen === 'inventory') renderInventory();
            if (screen === 'stats') renderStats();
            if (screen === 'ledger') renderTAccounts();
            if (screen === 'mission') updateAvgTimeDisplay();
            if (screen === 'leaderboard') {
                const tabs = document.querySelectorAll('#leaderboard-tabs button');
                tabs.forEach(b => b.classList.remove('active'));
                const overallTab = document.querySelector('#leaderboard-tabs button[data-diff="overall"]');
                if (overallTab) overallTab.classList.add('active');
                renderLeaderboard('overall');
            }
        }

        function renderStats() {
            const container = document.getElementById('stats-content');
            
            const diffNames = { easy: 'Easy', medium: 'Medium', hard: 'Hard', ultra: 'Ultra' };
            const diffEmojis = { easy: '🟢', medium: '🟡', hard: '🔴', ultra: '🔥' };
            let timeRows = '';
            let totalTime = 0;
            let totalCount = 0;
            
            Object.keys(timeData).forEach(key => {
                const data = timeData[key];
                const avg = data.count > 0 ? Math.round(data.totalTime / data.count) : 0;
                const best = data.bestTime || 0;
                totalTime += data.totalTime;
                totalCount += data.count;
                
                let statusClass = 'time-stat';
                if (avg > 0 && avg < 30) statusClass += ' fast';
                else if (avg > 0 && avg < 60) statusClass += ' medium';
                else if (avg > 0) statusClass += ' slow';
                
                timeRows += `
                    <div style="background:rgba(15,23,42,0.8); padding:12px; border-radius:8px; text-align:center;">
                        <div style="font-size:20px;">${diffEmojis[key]}</div>
                        <div style="font-size:14px; color:var(--text-secondary);">${diffNames[key]}</div>
                        <div style="font-size:18px; font-weight:bold; color:${avg > 0 ? '#e2e8f0' : '#64748b'};">${avg > 0 ? avg + 's' : '—'}</div>
                        <div style="font-size:11px; color:#64748b;">${data.count} missions</div>
                        ${best > 0 ? `<div style="font-size:12px; color:var(--gold);">🏆 Best: ${best}s</div>` : ''}
                    </div>
                `;
            });
            
            const overallAvg = totalCount > 0 ? Math.round(totalTime / totalCount) : 0;
            
            container.innerHTML = `
                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:16px; margin-top:20px;">
                    <div style="background:rgba(30,41,59,0.8); padding:20px; border-radius:12px; text-align:center;">
                        <div style="color:var(--text-secondary); font-size:14px;">Level</div>
                        <div style="font-size:28px; font-weight:bold; color:var(--accent);">${level}</div>
                    </div>
                    <div style="background:rgba(30,41,59,0.8); padding:20px; border-radius:12px; text-align:center;">
                        <div style="color:var(--text-secondary); font-size:14px;">Total EXP</div>
                        <div style="font-size:28px; font-weight:bold; color:var(--exp-color);">${exp}</div>
                    </div>
                    <div style="background:rgba(30,41,59,0.8); padding:20px; border-radius:12px; text-align:center;">
                        <div style="color:var(--text-secondary); font-size:14px;">Next Level</div>
                        <div style="font-size:28px; font-weight:bold; color:#60a5fa;">${expToNextLevel} EXP</div>
                    </div>
                    <div style="background:rgba(30,41,59,0.8); padding:20px; border-radius:12px; text-align:center;">
                        <div style="color:var(--text-secondary); font-size:14px;">Total Coins</div>
                        <div style="font-size:28px; font-weight:bold; color:#f1c40f;">${coins} 🪙</div>
                    </div>
                    <div style="background:rgba(30,41,59,0.8); padding:20px; border-radius:12px; text-align:center;">
                        <div style="color:var(--text-secondary); font-size:14px;">Missions Completed</div>
                        <div style="font-size:28px; font-weight:bold; color:#60a5fa;">${missionsCompleted}</div>
                    </div>
                    <div style="background:rgba(30,41,59,0.8); padding:20px; border-radius:12px; text-align:center;">
                        <div style="color:var(--text-secondary); font-size:14px;">Avg Time (Overall)</div>
                        <div style="font-size:28px; font-weight:bold; color:${overallAvg > 0 && overallAvg < 30 ? '#4ade80' : overallAvg > 0 && overallAvg < 60 ? '#facc15' : '#e2e8f0'};">${overallAvg > 0 ? overallAvg + 's' : '—'}</div>
                    </div>
                    <div style="background:rgba(30,41,59,0.8); padding:20px; border-radius:12px; text-align:center;">
                        <div style="color:var(--text-secondary); font-size:14px;">Player</div>
                        <div style="font-size:22px; font-weight:bold; color:var(--primary);">${getDisplayName(currentUser) || 'Guest'}</div>
                    </div>
                </div>
                
                <div style="margin-top:20px; padding:20px; background:rgba(30,41,59,0.8); border-radius:12px;">
                    <h3 style="margin-bottom:12px;">⏱️ Average Time by Difficulty</h3>
                    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, 1fr)); gap:12px;">
                        ${timeRows}
                    </div>
                    <div style="margin-top:12px; font-size:13px; color:#64748b; text-align:center;">
                        💡 Faster times indicate better mastery of the material! 🏆 Top 3 get exclusive rewards!
                    </div>
                </div>
                
                <div style="margin-top:20px; padding:20px; background:rgba(30,41,59,0.8); border-radius:12px;">
                    <h3 style="margin-bottom:10px;">📊 Reward System</h3>
                    <p style="color:var(--text-secondary);">Your rewards are based on your accuracy score. Higher accuracy = more coins and EXP!</p>
                    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(150px,1fr)); gap:12px; margin-top:12px;">
                        <div style="background:rgba(15,23,42,0.8); padding:12px; border-radius:8px; text-align:center;">
                            <div style="color:#4ade80; font-size:20px;">🎯</div>
                            <div style="font-size:14px; color:var(--text-secondary);">Accuracy</div>
                            <div style="font-size:18px; font-weight:bold;">${missionsCompleted > 0 ? Math.round((missionsCompleted / (missionsCompleted + incorrectAttempts)) * 100) : 0}%</div>
                        </div>
                        <div style="background:rgba(15,23,42,0.8); padding:12px; border-radius:8px; text-align:center;">
                            <div style="color:#f1c40f; font-size:20px;">🪙</div>
                            <div style="font-size:14px; color:var(--text-secondary);">Avg Coins/Mission</div>
                            <div style="font-size:18px; font-weight:bold;">${missionsCompleted > 0 ? Math.round(coins / missionsCompleted) : 0}</div>
                        </div>
                        <div style="background:rgba(15,23,42,0.8); padding:12px; border-radius:8px; text-align:center;">
                            <div style="color:var(--exp-color); font-size:20px;">⭐</div>
                            <div style="font-size:14px; color:var(--text-secondary);">Avg EXP/Mission</div>
                            <div style="font-size:18px; font-weight:bold;">${missionsCompleted > 0 ? Math.round(exp / missionsCompleted) : 0}</div>
                        </div>
                    </div>
                </div>
                
                <div style="margin-top:20px; padding:20px; background:rgba(30,41,59,0.8); border-radius:12px;">
                    <h3 style="margin-bottom:10px;">💡 Learning Tips</h3>
                    <ul style="list-style:none; text-align:left; line-height:2;">
                        <li>📝 Remember: Debits go on the LEFT, Credits on the RIGHT</li>
                        <li>💰 Assets increase with DEBIT, decrease with CREDIT</li>
                        <li>🏦 Liabilities increase with CREDIT, decrease with DEBIT</li>
                        <li>📊 Always check that total Debits = total Credits</li>
                        <li>🔄 Don't be afraid to make mistakes - that's how we learn!</li>
                        <li>⏱️ Track your times to see your improvement over time!</li>
                        <li>🏆 Compete for top 3 on the leaderboard for exclusive rewards!</li>
                    </ul>
                </div>
            `;
        }

        function showFeedback(text, type) {
            const fb = document.getElementById('feedback');
            fb.textContent = text;
            fb.style.display = 'block';
            fb.style.background = type === 'success' ? '#10b981' : '#ef4444';
            setTimeout(() => fb.style.display = 'none', 2500);
        }

        function renderAllGameContent() {
            generateCalendar();
            updateDisplay();
            renderShop();
            renderInventory();
            renderStats();
            renderTAccounts();
            applyTheme();
            updateAvgTimeDisplay();
            renderLeaderboard('overall');
            updateDisplayNameUI();
        }

        // ============================================================
        // INITIALIZATION
        // ============================================================
        function initGame() {
            ensureAdminData();
            
            if (currentUser) {
                const user = users.find(u => u.user === currentUser);
                if (user && user.role === 'Admin') {
                    const adminData = loadUserGameData(currentUser);
                    if (!adminData.coins || adminData.coins === 0) {
                        adminData.coins = 5000;
                        saveUserGameData(currentUser, adminData);
                    }
                }
                loadGameProgress();
                showView('home');
                renderAllGameContent();
                updateAdminButton();
                updateDisplayNameUI();
            } else {
                showView('login');
            }
        }

        window.onload = initGame;
    </script>
</body>
</html>