        function generateDailyTransactions(day, difficulty, version) {
            const diffCode = difficulty === 'easy' ? 7 : difficulty === 'medium' ? 13 : 23;
            const seed = day * 7919 + version * 6271 + diffCode * 5437;
            
            function seededRandom(seedVal) {
                const x = Math.sin(seedVal) * 10000;
                return x - Math.floor(x);
            }
            
            function rand(min, max, offset = 0) {
                const val = seededRandom(seed + min * 37 + max * 53 + offset * 71);
                return Math.floor(val * (max - min + 1)) + min;
            }
            
            function shuffleArray(arr, offset) {
                const result = [...arr];
                for (let i = result.length - 1; i > 0; i--) {
                    const j = rand(0, i, offset + i * 89);
                    [result[i], result[j]] = [result[j], result[i]];
                }
                return result;
            }
            
            const amounts = {
                easy: [75, 120, 200, 300, 450, 500, 150, 250, 180, 350, 90, 275, 420, 380, 160, 210, 320, 280, 400, 550, 125, 225, 375, 425, 175, 310, 340, 460, 490, 215],
                medium: [600, 850, 1200, 1500, 2200, 2800, 3500, 4200, 4800, 5500, 1800, 2500, 3200, 4000, 5000, 2100, 2900, 3800, 4500, 5200, 1600, 2600, 3400, 4600, 5400, 1900, 2700, 3600, 4900, 5300],
                hard: [700, 1200, 1800, 2500, 3200, 4000, 4800, 5600, 6500, 7800, 2200, 3500, 4200, 5800, 7200, 2800, 3900, 5100, 6200, 7500, 1900, 3100, 4300, 5700, 6900, 2400, 3700, 4900, 6100, 7300]
            };
            
            let pool;
            if (difficulty === 'easy') pool = EASY_POOL;
            else if (difficulty === 'medium') pool = MEDIUM_POOL;
            else pool = HARD_POOL;
            
            if (pool.length === 0) {
                console.error(`Pool for ${difficulty} is empty!`);
                return [];
            }
            
            const numTransactions = difficulty === 'easy' ? 3 : difficulty === 'medium' ? 4 : 5;
            const availableAmounts = amounts[difficulty] || amounts.easy;
            
            const shuffledPool = shuffleArray(pool, version * 97 + day * 83);
            const shuffledAmounts = shuffleArray(availableAmounts, version * 73 + day * 61);
            
            const startIdx = (version * 53 + day * 47) % shuffledPool.length;
            
            const selected = [];
            const usedIndices = new Set();
            
            for (let i = 0; i < numTransactions; i++) {
                let scenarioIdx;
                let attempts = 0;
                do {
                    scenarioIdx = (startIdx + i * (version % 5 + 1) + day * 3 + attempts * 7) % shuffledPool.length;
                    attempts++;
                } while (usedIndices.has(scenarioIdx) && attempts < shuffledPool.length);
                usedIndices.add(scenarioIdx);
                
                const scenario = shuffledPool[scenarioIdx];
                const amountIdx = (i * (version % 7 + 1) + day * 5 + version * 2) % shuffledAmounts.length;
                const amount = shuffledAmounts[amountIdx];
                
                const transaction = {
                    id: day * 100000 + (difficulty === 'easy' ? 1 : difficulty === 'medium' ? 2 : 3) * 10000 + version * 1000 + i + 1,
                    desc: scenario.desc,
                    correctDebit: scenario.debit,
                    correctCredit: scenario.credit,
                    amount: amount,
                    explanation: scenario.explanation || `${scenario.debit} increases → Debit ${scenario.debit}<br>${scenario.credit} increases → Credit ${scenario.credit}`
                };
                selected.push(transaction);
            }
            
            return selected;
        }

