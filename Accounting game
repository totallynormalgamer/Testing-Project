        function createVariations(baseDesc, debit, credit, explanation, count) {
            const variations = [];
            const words = [
                (s) => s,
                (s) => s.replace(/customer/g, 'client'),
                (s) => s.replace(/customer/g, 'company'),
                (s) => s.replace(/paid/g, 'disbursed'),
                (s) => s.replace(/received/g, 'collected'),
                (s) => s.replace(/purchased/g, 'acquired'),
                (s) => s.replace(/sold/g, 'disposed of'),
                (s) => s.replace(/cash/g, 'currency'),
                (s) => s.replace(/expense/g, 'cost'),
                (s) => s.replace(/revenue/g, 'income'),
                (s) => s.replace(/payable/g, 'owed'),
                (s) => s.replace(/receivable/g, 'owed to us'),
                (s) => s.replace(/paid/g, 'settled'),
                (s) => s.replace(/received/g, 'obtained'),
                (s) => s.replace(/purchased/g, 'bought'),
                (s) => s.replace(/cash/g, 'funds'),
                (s) => s.replace(/expense/g, 'charge'),
                (s) => s.replace(/revenue/g, 'earnings')
            ];
            
            for (let i = 0; i < count; i++) {
                const idx = i % words.length;
                const amount = 50 + (i * 37 + 73) % 750;
                const desc = words[idx](baseDesc(amount));
                
                let detailedExplanation = explanation || '';
                if (!detailedExplanation) {
                    const debitType = getAccountType(debit);
                    const creditType = getAccountType(credit);
                    detailedExplanation = `• <strong>${debit}</strong> is a ${debitType}. ${debitType === 'Asset' || debitType === 'Expense' ? 'It increases with a DEBIT (left side).' : 'It increases with a CREDIT (right side).'}<br>`;
                    detailedExplanation += `• <strong>${credit}</strong> is a ${creditType}. ${creditType === 'Asset' || debitType === 'Expense' ? 'It increases with a DEBIT (left side).' : 'It increases with a CREDIT (right side).'}<br>`;
                    detailedExplanation += `• Since we are ${debitType === 'Asset' || debitType === 'Expense' ? 'INCREASING' : 'DECREASING'} ${debit}, we DEBIT it.<br>`;
                    detailedExplanation += `• Since we are ${creditType === 'Liability' || creditType === 'Equity' || creditType === 'Revenue' ? 'INCREASING' : 'DECREASING'} ${credit}, we CREDIT it.`;
                }
                variations.push({
                    desc: desc,
                    debit: debit,
                    credit: credit,
                    explanation: detailedExplanation
                });
            }
            return variations;
        }

