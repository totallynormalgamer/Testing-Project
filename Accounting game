    <script>
        // ============================================================
        // PERSISTENT AUTH SYSTEM - All data saved to localStorage
        // ============================================================
        
        let users = [];
        try {
            const storedUsers = localStorage.getItem('bankUsers');
            if (storedUsers) {
                users = JSON.parse(storedUsers);
            } else {
                users = [{ user: "Admin0427", pass: "Isaac0427", role: "Admin" }];
                localStorage.setItem('bankUsers', JSON.stringify(users));
            }
        } catch(e) {
            users = [{ user: "Admin0427", pass: "Isaac0427", role: "Admin" }];
            localStorage.setItem('bankUsers', JSON.stringify(users));
        }

        let currentUser = localStorage.getItem('bankSessionUser') || "";
        let selectedUserToDelete = null;

        // User inventory for shop items
        let userInventory = {};

        function getUserInventory(username) {
            const key = 'bankInventory_' + username;
            const data = localStorage.getItem(key);
            if (data) {
                try { return JSON.parse(data); }
                catch(e) { return {}; }
            }
            return {};
        }

        function saveUserInventory(username, inventory) {
            const key = 'bankInventory_' + username;
            localStorage.setItem(key, JSON.stringify(inventory));
        }

        function getUserDataKey(username) {
            return 'bankGameData_' + username;
        }

        function getDefaultUserData() {
            return {
                coins: 0,
                exp: 0,
                level: 1,
                missionsCompleted: 0,
                expToNextLevel: 100,
                currentTheme: 'dark',
                timeData: {
                    easy: { totalTime: 0, count: 0, bestTime: 0 },
                    medium: { totalTime: 0, count: 0, bestTime: 0 },
                    hard: { totalTime: 0, count: 0, bestTime: 0 },
                    ultra: { totalTime: 0, count: 0, bestTime: 0 }
                },
                leaderboardRewards: {
                    easy: { claimed: false, rank: 0 },
                    medium: { claimed: false, rank: 0 },
                    hard: { claimed: false, rank: 0 },
                    ultra: { claimed: false, rank: 0 },
                    overall: { claimed: false, rank: 0 }
                }
            };
        }

        function loadUserGameData(username) {
            const key = getUserDataKey(username);
            const data = localStorage.getItem(key);
            if (data) {
                try { 
                    const parsed = JSON.parse(data);
                    if (!parsed.timeData) {
                        parsed.timeData = getDefaultUserData().timeData;
                    }
                    if (!parsed.leaderboardRewards) {
                        parsed.leaderboardRewards = getDefaultUserData().leaderboardRewards;
                    }
                    return parsed;
                }
                catch(e) { return getDefaultUserData(); }
            }
            return getDefaultUserData();
        }

        function saveUserGameData(username, data) {
            const key = getUserDataKey(username);
            localStorage.setItem(key, JSON.stringify(data));
        }

        function deleteUserGameData(username) {
            const key = getUserDataKey(username);
            localStorage.removeItem(key);
            localStorage.removeItem('bankInventory_' + username);
        }

        function getAllUserGameData() {
            const allData = {};
            users.forEach(u => {
                allData[u.user] = loadUserGameData(u.user);
            });
            return allData;
        }

        function saveUsers() {
            localStorage.setItem('bankUsers', JSON.stringify(users));
        }

        function setSessionUser(user) {
            currentUser = user;
            localStorage.setItem('bankSessionUser', user);
            userInventory = getUserInventory(user);
            updateUserDisplay();
            updateAdminButton();
            loadGameProgress();
            applyTheme();
        }

        function clearSession() {
            currentUser = "";
            localStorage.removeItem('bankSessionUser');
            userInventory = {};
            updateUserDisplay();
            updateAdminButton();
        }

        function updateUserDisplay() {
            const display = document.getElementById('current-user-display');
            if (display) {
                display.textContent = currentUser || 'Guest';
            }
        }

        function updateAdminButton() {
            const btn = document.getElementById('adminPanelBtn');
            const user = users.find(u => u.user === currentUser);
            if (user && user.role === 'Admin') {
                btn.classList.remove('hidden');
            } else {
                btn.classList.add('hidden');
            }
        }

        function showAuthAlert(msg) {
            const alert = document.getElementById('authAlert');
            alert.textContent = msg || 'Please login to perform this action!';
            alert.classList.add('show');
            setTimeout(() => alert.classList.remove('show'), 3000);
        }

        // --- THEME SYSTEM ---
        const themes = {
            dark: { bg: 'linear-gradient(135deg, #0f172a, #1e2937)', primary: '#4a90e2' },
            ocean: { bg: 'linear-gradient(135deg, #0c4a6e, #0f766e)', primary: '#38bdf8' },
            forest: { bg: 'linear-gradient(135deg, #14532d, #15803d)', primary: '#4ade80' },
            sunset: { bg: 'linear-gradient(135deg, #7c2d12, #9a3412)', primary: '#fb923c' },
            neon: { bg: 'linear-gradient(135deg, #1a1a2e, #16213e)', primary: '#e94560' },
