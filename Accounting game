        function saveEntry(id) {
            if (!currentUser) {
                showAuthAlert('Please login to save entries!');
                return;
            }
            if (missionSubmitted) {
                showFeedback("Mission already submitted!", "danger");
                return;
            }
            
            const e = playerEntries[id];
            if (!e) {
                showFeedback("Please fill in all fields first!", "danger");
                return;
            }
            
            if (!e.debit || !e.credit) {
                showFeedback("Please select both debit and credit accounts!", "danger");
                return;
            }
            
            if (e.amount === '' || e.amount === undefined || e.amount === null || !Number.isFinite(e.amount)) {
                showFeedback("Please enter a valid amount!", "danger");
                return;
            }
            
            if (e.amount <= 0) {
                showFeedback("Amount must be greater than 0", "danger");
                return;
            }
            
            const trans = transactions.find(t => t.id === id);
            if (!trans) {
                showFeedback("Transaction not found!", "danger");
                return;
            }
            
            const descAmount = extractAmountFromDesc(trans.desc);
            const correctAmount = descAmount !== null ? descAmount : trans.amount;
            
            const isCorrect = e.debit === trans.correctDebit && e.credit === trans.correctCredit && e.amount === correctAmount;
            
            if (!isCorrect) {
                incorrectAttempts++;
                if (!mistakes[id]) mistakes[id] = 0;
                mistakes[id]++;
                showFeedback(`⚠️ That's not quite right. Try again!`, "danger");
                const container = document.getElementById('transactions-list');
                container.classList.add('error-highlight');
                setTimeout(() => container.classList.remove('error-highlight'), 500);
                return;
            }
            
            journal = journal.filter(j => j.id !== id);
            journal.push({
                id: id,
                desc: trans.desc,
                debit: e.debit,
                credit: e.credit,
                amount: correctAmount
            });
            
            editingId = null;
            renderTransactions();
            renderJournal();
            updateJournalBalance();
            showFeedback("✅ Entry saved! Great job!", "success");
        }

