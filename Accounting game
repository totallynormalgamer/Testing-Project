        function buyTheme(itemId, themeName) {
            if (!currentUser) {
                showAuthAlert('Please login to buy themes!');
                return;
            }
            const item = SHOP_ITEMS.find(i => i.id === itemId);
            if (!item) return;
            
            if (userInventory[itemId] || item.price === 0) {
                setTheme(themeName);
                return;
            }
            
            if (coins < item.price) {
                showFeedback(`Not enough coins! Need ${item.price} 🪙`, 'danger');
                return;
            }
            
            coins -= item.price;
            userInventory[itemId] = 1;
            saveGameProgress();
            renderShop();
            updateDisplay();
            setTheme(themeName);
            showFeedback(`✅ Purchased ${item.name} theme!`, 'success');
        }

        function buyItem(itemId) {
            if (!currentUser) {
                showAuthAlert('Please login to shop!');
                return;
            }
            const item = SHOP_ITEMS.find(i => i.id === itemId);
            if (!item) return;
            
            if (coins < item.price) {
                showFeedback(`Not enough coins! Need ${item.price} 🪙`, 'danger');
                return;
            }
            
            coins -= item.price;
            if (!userInventory[itemId]) userInventory[itemId] = 0;
            userInventory[itemId]++;
            saveGameProgress();
            renderShop();
            updateDisplay();
            showFeedback(`✅ Purchased ${item.name}!`, 'success');
        }

