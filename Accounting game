        function getLeaderboard(difficulty) {
            const allData = getAllUserGameData();
            const entries = [];
            
            Object.keys(allData).forEach(username => {
                const data = allData[username];
                const user = users.find(u => u.user === username);
                if (!user) return;
                
                let time = 0;
                let count = 0;
                let bestTime = 0;
                const displayName = data.displayName || username;
                
                if (difficulty === 'overall') {
                    let totalTime = 0;
                    let totalCount = 0;
                    Object.values(data.timeData || {}).forEach(d => {
                        totalTime += d.totalTime || 0;
                        totalCount += d.count || 0;
                    });
                    time = totalCount > 0 ? Math.round(totalTime / totalCount) : 0;
                    count = totalCount;
                } else if (data.timeData && data.timeData[difficulty]) {
                    const d = data.timeData[difficulty];
                    time = d.count > 0 ? Math.round(d.totalTime / d.count) : 0;
                    count = d.count;
                    bestTime = d.bestTime || 0;
                }
                
                if (count > 0) {
                    entries.push({
                        username: username,
                        displayName: displayName,
                        avgTime: time,
                        count: count,
                        bestTime: bestTime,
                        role: user.role,
                        level: data.level || 1
                    });
                }
            });
            
            entries.sort((a, b) => a.avgTime - b.avgTime);
            return entries;
        }

