            const container = document.getElementById('transactions-list');
            container.innerHTML = '';
            
            const relevantAccounts = getRelevantAccounts(transactions);
            const allAccounts = [...new Set([...relevantAccounts, ...ALL_ACCOUNTS])].sort();
            
            transactions.forEach((t, index) => {
                const recorded = journal.find(j => j.id === t.id);
                const isRecorded = !!recorded;
                const isEditing = editingId === t.id;
                const div = document.createElement('div');
                let isIncorrect = false;
                if (recorded && missionSubmitted) {
                    isIncorrect = !(recorded.debit === t.correctDebit && recorded.credit === t.correctCredit && recorded.amount === t.amount);
                }
                div.className = `transaction ${isRecorded ? 'recorded' : ''} ${isIncorrect ? 'incorrect' : ''}`;
                
                let html = `<div style="flex:1;"><strong>Transaction ${index + 1}:</strong><br><span>${t.desc}</span></div>`;

                if (isRecorded && !isEditing) {
                    html += `<div style="flex:1;"><div style="background:#0f172a;padding:12px;border-radius:8px;">Recorded: ${recorded.debit} (Dr) / ${recorded.credit} (Cr) $${recorded.amount}</div>`;
                    if (missionSubmitted) {
                        const correct = recorded.debit === t.correctDebit && recorded.credit === t.correctCredit && recorded.amount === t.amount;
                        html += `<div class="correct-answer" style="margin-top:10px;color:${correct ? '#4ade80' : '#f87171'}">
                            <strong>${correct ? '✅ Correct' : '❌ Wrong'}</strong>
                            ${!correct ? `<br><small style="color:#94a3b8;">Correct: Dr ${t.correctDebit} / Cr ${t.correctCredit}</small>` : ''}
                        </div>`;
                    } else {
                        html += `<button onclick="startEdit(${t.id})" class="edit-btn" style="margin-top:10px;">✏️ Edit</button>`;
                    }
                    html += `</div>`;
                } else if (!missionSubmitted) {
                    const cur = playerEntries[t.id] || {};
                    const accountOptions = allAccounts.map(a => 
                        `<option value="${a}" ${cur.debit===a?'selected':''}>${a}</option>`
                    ).join('');
                    
                    html += `
                        <div style="flex:1;">
                            <div class="entry-form">
                                <div><div class="entry-label">Debit Account</div>
                                    <select onchange="updateEntry(${t.id},this)">
                                        <option value="">Select</option>
                                        ${accountOptions}
                                    </select>
                                </div>
                                <div><div class="entry-label">Credit Account</div>
                                    <select onchange="updateEntry(${t.id},this)">
                                        <option value="">Select</option>
                                        ${accountOptions}
                                    </select>
                                </div>
                                <div><div class="entry-label">Amount</div>
                                    <input type="number" value="${cur.amount||''}" onchange="updateEntry(${t.id},this)" style="width:100%">
                                </div>
                                <div style="display:flex;align-items:flex-end;">
                                    <button onclick="saveEntry(${t.id})">${isEditing ? 'Save Changes' : 'Record'}</button>
                                </div>
                            </div>
                        </div>`;
                }
                div.innerHTML = html;
                container.appendChild(div);
            });
        }

        function updateEntry(id, el) {
            if (!playerEntries[id]) playerEntries[id] = {};
            if (el.tagName === "SELECT") {
                const label = el.parentElement.querySelector('.entry-label');
                const isDebit = label ? label.textContent.includes("Debit") : false;
                playerEntries[id][isDebit ? 'debit' : 'credit'] = el.value;
            } else {
                playerEntries[id].amount = parseFloat(el.value);
            }
        }

        function saveEntry(id) {
            if (missionSubmitted) {
                showFeedback("Mission already submitted!", "danger");
                return;
            }
            
            const e = playerEntries[id];
            if (!e) {
                showFeedback("Please fill in all fields first!", "danger");
                return;
            }
            
            if (!e.debit || !e.credit || !Number.isFinite(e.amount)) {
                showFeedback("Please fill all fields!", "danger");
                return;
            }
            
            if (e.amount <= 0) {
                showFeedback("Amount must be > 0", "danger");
                return;
            }
            
            const trans = transactions.find(t => t.id === id);
            if (!trans) {
                showFeedback("Transaction not found!", "danger");
                return;
            }
            
            const isCorrect = e.debit === trans.correctDebit && e.credit === trans.correctCredit && e.amount === trans.amount;
            
            if (!isCorrect) {
                incorrectAttempts++;
                if (!mistakes[id]) mistakes[id] = 0;
                mistakes[id]++;
                showFeedback(`⚠️ That's not quite right. Try again!`, "danger");
                const container = document.getElementById('transactions-list');
                container.classList.add('error-highlight');
                setTimeout(() => container.classList.remove('error-highlight'), 500);
                return;
            }
            
            journal = journal.filter(j => j.id !== id);
            journal.push({
                id: id,
                desc: trans.desc,
                debit: e.debit,
                credit: e.credit,
                amount: e.amount
            });
            
            editingId = null;
            renderTransactions();
            renderJournal();
            updateJournalBalance();
            showFeedback("✅ Entry saved! Great job!", "success");
        }

        function startEdit(id) {
            if (missionSubmitted) return;
            const rec = journal.find(j => j.id === id);
            if (rec) {
                playerEntries[id] = {debit: rec.debit, credit: rec.credit, amount: rec.amount};
                editingId = id;
                renderTransactions();
            }
        }

        function renderJournal() {
            const tbody = document.getElementById('journal-body');
            tbody.innerHTML = '';
            if (journal.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" style="padding:20px;text-align:center;color:#94a3b8;">No entries recorded yet</td></tr>`;
                return;
            }
            journal.forEach((j) => {
                const row = document.createElement('tr');
                row.style.borderBottom = "1px solid #334155";
                row.innerHTML = `
                    <td style="padding:12px;">${j.desc}</td>
                    <td style="padding:12px;color:#4ade80;text-align:center;">${j.debit}</td>
                    <td style="padding:12px;color:#f87171;text-align:center;">${j.credit}</td>
                    <td style="padding:12px;text-align:right;">$${j.amount}</td>
                `;
                tbody.appendChild(row);
            });
        }

        function updateJournalBalance() {
            const container = document.getElementById('journal-balance');
            if (!container) return;
            
            if (journal.length === 0) {
                container.innerHTML = `<div class="balance-display" style="border-color:#475569;">
                    <span style="color:#94a3b8;">No entries yet — start recording transactions above</span>
                </div>`;
                return;
            }

            let totalDebits = 0;
            let totalCredits = 0;
            
            journal.forEach(entry => {
                totalDebits += entry.amount;
                totalCredits += entry.amount;
            });
            
            const isBalanced = totalDebits === totalCredits;
            
            container.innerHTML = `
                <div class="balance-display" style="border-color:#475569;">
                    <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;">
                        <span>Total Debits: <strong style="color:#4ade80;">$${totalDebits.toFixed(2)}</strong></span>
                        <span>Total Credits: <strong style="color:#f87171;">$${totalCredits.toFixed(2)}</strong></span>
                        ${!isBalanced ? '<span style="color:#f87171;font-weight:bold;">❌ NOT BALANCED</span>' : '<span style="color:#4ade80;font-weight:bold;">✅ BALANCED</span>'}
                    </div>
                </div>
            `;
        }

        function submitMission() {
            if (journal.length !== transactions.length) {
                return showFeedback(`Record all ${transactions.length} transactions first!`, "danger");
            }
            
            let totalDebits = 0;
            let totalCredits = 0;
            journal.forEach(j => {
                totalDebits += j.amount;
                totalCredits += j.amount;
            });
            
            if (totalDebits !== totalCredits) {
                return showFeedback("Journal must balance! Debits ≠ Credits", "danger");
            }
            
            missionSubmitted = true;
            lastMissionJournal = [...journal];

            const timeTaken = Math.floor((Date.now() - startTime) / 1000);
            let correct = 0;
            journal.forEach(j => {
                const t = transactions.find(tr => tr.id === j.id);
                if (t && j.debit === t.correctDebit && j.credit === t.correctCredit && j.amount === t.amount) correct++;
            });
            const score = Math.round((correct / journal.length) * 100);
            
            const penalty = Math.min(incorrectAttempts * 2, 20);
            const finalScore = Math.max(0, score - penalty);
            
            // Diminishing returns on coin rewards based on missions completed
            // Each completed mission reduces coin reward by 5%, down to a minimum of 20% of base
            const coinDiminishFactor = Math.max(0.2, 1 - (missionsCompleted * 0.05));
            const expDiminishFactor = Math.max(0.5, 1 - (missionsCompleted * 0.02));
            
            const diffMultiplier = currentDifficulty === 'easy' ? 1 : currentDifficulty === 'medium' ? 2 : 3;
            const baseExp = Math.floor((5 + diffMultiplier * 3) * (finalScore / 100));
            const baseCoins = Math.floor((30 + diffMultiplier * 20) * (finalScore / 100));
            
            const expEarned = Math.max(1, Math.floor(baseExp * expDiminishFactor));
            const coinEarned = Math.max(1, Math.floor(baseCoins * coinDiminishFactor));
            
            missionsCompleted++;
            coins += coinEarned;
            const leveledUp = addExp(expEarned);

            renderResults(timeTaken, score, finalScore, expEarned, coinEarned, leveledUp, coinDiminishFactor);
            showScreen('results');
            
            const message = finalScore === 100 ? "🌟 PERFECT DAY!" : 
                           finalScore >= 80 ? "👍 Good job!" : 
                           finalScore >= 60 ? "📚 Keep learning!" : "💪 Practice makes perfect!";
            
            showModal(message, `
                <div style="text-align:left; margin-top:10px;">
                    <div>Raw Score: ${score}%</div>
                    <div>Penalty: ${penalty}% (${incorrectAttempts} incorrect attempts)</div>
                    <div>Final Score: ${finalScore}%</div>
                    <div>⭐ EXP Earned: ${expEarned}</div>
                    <div>🪙 Coins Earned: ${coinEarned} (${Math.round(coinDiminishFactor * 100)}% of base)</div>
                    <div style="margin-top:10px; color:#94a3b8; font-size:14px;">
                        ${missionsCompleted > 5 ? '📉 Coin rewards decrease as you complete more missions to encourage variety!' : ''}
                        ${incorrectAttempts > 0 ? '💡 Learning from mistakes is the best way to improve!' : '🎯 Perfect! No mistakes made!'}
                    </div>
                </div>
            `);
        }

