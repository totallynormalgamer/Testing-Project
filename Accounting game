        function renderTAccounts() {
            const container = document.getElementById('t-accounts');
            container.innerHTML = '';
            document.getElementById('ledger-mission-info').textContent = `Mission • June ${currentDay} • ${currentDifficulty ? currentDifficulty.toUpperCase() : ''} • Version ${currentVersion}`;

            const balances = {};
            lastMissionJournal.forEach(entry => {
                if (!balances[entry.debit]) balances[entry.debit] = 0;
                if (!balances[entry.credit]) balances[entry.credit] = 0;
                balances[entry.debit] += entry.amount;
                balances[entry.credit] -= entry.amount;
            });

            const allAccounts = new Set();
            lastMissionJournal.forEach(entry => {
                allAccounts.add(entry.debit);
                allAccounts.add(entry.credit);
            });

            allAccounts.forEach(acc => {
                if (!balances[acc]) balances[acc] = 0;
            });

            const sortedAccounts = Object.keys(balances).sort((a, b) => {
                const balA = balances[a];
                const balB = balances[b];
                if (balA > 0 && balB <= 0) return -1;
                if (balA <= 0 && balB > 0) return 1;
                return 0;
            });

            sortedAccounts.forEach(acc => {
                const bal = balances[acc];
                const isBalanced = bal === 0;
                const div = document.createElement('div');
                div.className = `t-account ${isBalanced ? 'balanced' : 'unbalanced'}`;
                
                const hasDebitBalance = bal > 0;
                const hasCreditBalance = bal < 0;
                
                div.innerHTML = `
                    <h3 style="display:flex;justify-content:space-between;align-items:center;">
                        <span>${acc}</span>
                        <span class="balance-badge ${isBalanced ? 'balanced' : 'unbalanced'}">
                            ${isBalanced ? '⚖️ Balanced' : hasDebitBalance ? '🔴 Debit Balance' : '🔵 Credit Balance'}
                        </span>
                    </h3>
                    <div style="display:flex;justify-content:space-between;margin-top:8px;">
                        <span>Debit: <strong style="color:#4ade80;">$${bal > 0 ? bal.toFixed(2) : '0.00'}</strong></span>
                        <span>Credit: <strong style="color:#f87171;">$${bal < 0 ? Math.abs(bal).toFixed(2) : '0.00'}</strong></span>
                    </div>
                    <div style="margin-top:8px; font-size:14px; color:#94a3b8;">
                        ${isBalanced ? '✅ Account is in balance' : hasDebitBalance ? '⚠️ Account has a debit balance' : '⚠️ Account has a credit balance'}
                    </div>
                `;
                container.appendChild(div);
            });

            if (sortedAccounts.length === 0) {
                container.innerHTML = `<div style="grid-column:1/-1;text-align:center;color:#94a3b8;padding:40px;">No transactions recorded yet</div>`;
            }
        }

