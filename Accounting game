        function submitMission() {
            if (!currentUser) {
                showAuthAlert('Please login to submit!');
                return;
            }
            if (missionSubmitted) {
                showFeedback("Mission already submitted!", "danger");
                return;
            }
            
            if (journal.length !== transactions.length) {
                return showFeedback(`Record all ${transactions.length} transactions first!`, "danger");
            }
            
            let totalDebits = 0;
            let totalCredits = 0;
            journal.forEach(j => {
                totalDebits += j.amount;
                totalCredits += j.amount;
            });
            
            if (totalDebits !== totalCredits) {
                return showFeedback("Journal must balance! Debits ≠ Credits", "danger");
            }
            
            missionSubmitted = true;
            lastMissionJournal = [...journal];

            const timeTaken = Math.floor((Date.now() - startTime) / 1000);
            
            // Track time for this difficulty
            if (currentDifficulty && timeData[currentDifficulty]) {
                timeData[currentDifficulty].totalTime += timeTaken;
                timeData[currentDifficulty].count++;
                // Track best time
                if (timeData[currentDifficulty].bestTime === 0 || timeTaken < timeData[currentDifficulty].bestTime) {
                    timeData[currentDifficulty].bestTime = timeTaken;
                }
                saveGameProgress();
            }
            
            let correct = 0;
            journal.forEach(j => {
                const t = transactions.find(tr => tr.id === j.id);
                if (t) {
                    const descAmount = extractAmountFromDesc(t.desc);
                    const correctAmount = descAmount !== null ? descAmount : t.amount;
                    if (j.debit === t.correctDebit && j.credit === t.correctCredit && j.amount === correctAmount) {
                        correct++;
                    }
                }
            });
            const score = Math.round((correct / journal.length) * 100);
            
            const penalty = Math.min(incorrectAttempts * 2, 20);
            const finalScore = Math.max(0, score - penalty);
            
            // Coin magnet boost
            let coinMultiplier = 1;
            if (userInventory.coin_boost && userInventory.coin_boost > 0) {
                coinMultiplier = 1.5;
                userInventory.coin_boost--;
                showFeedback('🧲 Coin Magnet activated! 50% more coins!', 'success');
            }
            
            const diffMultiplier = currentDifficulty === 'easy' ? 1 : currentDifficulty === 'medium' ? 2 : currentDifficulty === 'hard' ? 3 : 5;
            const baseExp = Math.floor((5 + diffMultiplier * 3) * (finalScore / 100));
            const baseCoins = Math.floor((30 + diffMultiplier * 20) * (finalScore / 100));
            
            const expEarned = Math.max(1, Math.floor(baseExp));
            const coinEarned = Math.max(1, Math.floor(baseCoins * coinMultiplier));
            
            missionsCompleted++;
            coins += coinEarned;
            const leveledUp = addExp(expEarned);
            saveGameProgress();

            // Get avg time for this difficulty
            const avgTime = timeData[currentDifficulty] && timeData[currentDifficulty].count > 0 
                ? Math.round(timeData[currentDifficulty].totalTime / timeData[currentDifficulty].count) 
                : 0;
            const bestTime = timeData[currentDifficulty] ? timeData[currentDifficulty].bestTime || 0 : 0;

            renderResults(timeTaken, score, finalScore, expEarned, coinEarned, leveledUp, avgTime, bestTime);
            showScreen('results');
            
            const message = finalScore === 100 ? "🌟 PERFECT DAY!" : 
                           finalScore >= 80 ? "👍 Good job!" : 
                           finalScore >= 60 ? "📚 Keep learning!" : "💪 Practice makes perfect!";
            
            const diffNames = { easy: 'Easy', medium: 'Medium', hard: 'Hard', ultra: 'Ultra' };
            showModal(message, `
                <div style="text-align:left; margin-top:10px;">
                    <div>Raw Score: ${score}%</div>
                    <div>Penalty: ${penalty}% (${incorrectAttempts} incorrect attempts)</div>
                    <div>Final Score: ${finalScore}%</div>
                    <div>⭐ EXP Earned: ${expEarned}</div>
                    <div>🪙 Coins Earned: ${coinEarned}</div>
                    <div>⏱️ Time: ${timeTaken}s</div>
                    <div style="color:#94a3b8; font-size:14px; margin-top:8px;">
                        📊 Avg time for ${diffNames[currentDifficulty]}: ${avgTime > 0 ? avgTime + 's' : 'N/A'}
                        ${bestTime > 0 ? '• 🏆 Best: ' + bestTime + 's' : ''}
                    </div>
                    <div style="margin-top:10px; color:#94a3b8; font-size:14px;">
                        ${incorrectAttempts > 0 ? '💡 Learning from mistakes is the best way to improve!' : '🎯 Perfect! No mistakes made!'}
                    </div>
                </div>
            `);
        }

